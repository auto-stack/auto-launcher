// pac.at — 028-launcher（Plan 464）。
//
// 桌面 launcher：palette（搜索 + 模糊过滤 + 键盘流）/ grid 两形态的真注册表
// 启动器。desktop 模式下由桌面 shell 以 overlay 槽召唤（463 SummonLauncher），
// 独立模式（`auto run`，vue 调试）自管开关 + 内嵌 mock 清单（I3 配置差异）。
//
// front_port: 4028 沿用 Plan 441 预订；icon 由 463 T7 注册表消费（缺省回退
// app-window）。render 声明 "vue"（开发目标端）；vm 兼容性由 T3/T4 实机验收
// 兜底（注册表扫描不过滤 render——463 T7 定案，声明的 render 是前端目标）。

name: "launcher"
version: "0.1.0"
description: "Desktop launcher - palette/grid app search & launch (vue/vm)"

scene: "ui"
render: "vue"
front_port: 17842
icon: "search"
title: "Launcher"
title_zh: "启动器"
category: "system"
desktop: "true"
# PLAN-039 T-07（D2-A）：a2r 编译 exe 声明——spawn_launcher_outproc
# 编译轨优先臂消费（产物缺席回退解释装载 I3）；生成门 0（批次 E 收官
# 2026-09-21）；debug 档开发环，release 升档随收口批。
desktop_exe: "rust-workspace/target/debug/launcher.exe"
# auto-os/PLAN-057 T-02：官方主题包正式接入——`vendor/themes` 为 UI 管理渠道
# 发布的**固定版本快照**（themes 0.2.0，内容 digest
# 9fa07742dc68aa5377ae06cb2d966386002063f184c515b6c5dddf8a6bef838e，
# per-file sha256 与源包逐文件校验同律；不可二次编辑、非第二权威源）。
# theme 键保持缺省 = follow 宿主（宿主策略完整快照 > 本 design 默认 > legacy
# 回退）。主合同反链见 README。
dep themes {
    path: "vendor/themes"
}

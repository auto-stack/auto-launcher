// app.at — 028-launcher 根组件（Plan 464）。
//
// 形态：palette（搜索 + 模糊过滤 + 选中高亮 + 键盘流）与 grid（图标网格，
// T2）两形态的 overlay，由 `visible` 状态变量门控。desktop 模式下宿主经
// 463 接缝注入：SummonLauncher → visible="1"、应用清单 → `apps`、
// `__wm_*` 同型的状态注入（I3：数据来源差异，非代码分叉）；独立模式
// （`auto run`）内嵌 mock 清单 + 页面按钮自管开关。
//
// 单组件约束（025-dashboard 形态，双端转译实测结论，464 T1 盘点）：
//   - 模块级 fn 不进 vue SFC（024 先例 + 本计划探针复证）→ 模糊排序写成
//     状态法 handler（.ApplyFilter：读 q/apps/recent，写 ranked，纯状态变换，
//     规则钉死在 SPEC.md）；
//   - store 子组件的 vue TS 生成损坏（013/038 实测）→ 全部状态内聚 App；
//   - 模板文本插值里不能调 .len()（vue TS 编译错）→ 计数在 handler 算成
//     字符串/数值状态（.count/.nres）。
// 字符串比较一律针对预小写字段（ln/lt，mock 字面量给出、宿主注入时由宿主
// 预小写）：排序权重全整数，规避浮点/字符宽度双端差（SPEC §排序）。

widget App {
    msg {
        Init, SetQ(str), ApplyFilter, MoveUp, MoveDown, MoveLeft, MoveRight,
        Pick, Escape, SwitchMode, Open, Close, Launch(str), PickCat(str),
        OpenActions, RunAction, MoveActionUp, MoveActionDown,
        SetAppsOk(str), SetQlOk(str), SetImeComposing(str), RestoreProviders,
        RunActionKind(str), ReceiveProvider(str)
    }

    model {
        // ---- 接缝状态（desktop 宿主注入；独立模式恒默认值）----
        var visible str = "0"       // overlay 门控：宿主 SummonLauncher 置 "1"
        var hosted str = "0"        // 宿主挂载时写 "1"：隐藏独立模式的开门按钮
        var __desktop_cmd str = ""  // 上行命令总线（DesktopBus v1 记录形）
        var __focus_input str = "0" // 聚焦请求：置 "1" → 宿主聚焦 palette 输入框（消费即清零）

        // ---- 形态 ----
        var mode str = "palette"    // palette | grid

        // ---- Plan 503 分类胶囊 ----
        var cat str = "all"         // 当前分类（"all" = 全部）
        var cats = ["all", "tool", "task", "life", "notes", "social", "reading", "media", "data", "system", "game", "editor"]
        // PLAN-013 W2：零结果分类隐藏——ApplyFilter 期按注册表计数过滤。
        var cats_visible = ["all"]

        // ---- 查询与结果（LAUNCHER-001）----
        var q str = ""
        var ranked = []             // {i,name,title,icon,category,mg,sub,chip,tchip,result_id}
        var sel int = 0             // palette 选中索引（app 内自建焦点索引）
        var sel_result_id str = ""  // 选中实体键（result_id）
        var sel_provider str = ""   // P2-R02：选中 provider_id（完整身份）
        var sel_target str = ""     // P2-R02：选中目标（launch name / open url|path）
        var sel_kind str = "launch" // 当前动作 kind
        var nres int = 0            // 结果数（view 条件用，替代模板 .len()）
        var count str = ""          // 计数显示串
        // query_id：每次 SetQ/ApplyFilter 递增；过期响应按 id 丢弃（AC-02）
        var query_id int = 0
        var active_query_id int = 0
        var load_state str = "ready"   // ready | loading | error | empty
        var load_error str = ""
        // 动作菜单（T-03）：Ctrl+Enter 打开；Esc 先关菜单
        var actions_open str = "0"
        var action_sel int = 0
        var action_labels = ["Launch", "Open"]
        var action_kinds = ["launch", "open"]
        // 双 provider 健康位（R-01/R-03）："1"=可用；"0"=失败/停用。
        // 失败路整段剔除，另一路仍出结果；双失败 → load_state=error。
        var apps_ok str = "1"
        var ql_ok str = "1"
        var partial_note str = ""
        // IME 组合态（R-02）："1"=组合中 Enter/Esc 不触发 Pick/Escape
        //（L03；Web isComposing / 宿主 preedit 上报；VM 见 452 spike 键吞）
        var ime_composing str = "0"

        // ---- 网格形态（P5，对标 Activities/Launchpad）----
        var gridrows = []           // {gi,name,title,mg,category,chip,tchip} 注册表序全量
        var gsel int = 0            // 网格焦点索引（与 sel 同为 app 内自建）
        var gcount str = ""

        // ---- 注册表（独立模式 mock；desktop 模式宿主覆盖同名列表）----
        // 注入/存储形态 = 平行字符串列表（Obj 数组的 VM handler 字段读失效
        // ——B12 同族，464 探针钉死；字符串列表下标读保真）。
        // ln/lt = name/title 的预小写副本（匹配用，见文件头注）。
        // colors = 品牌色 6 位 hex（Plan 503；宿主注入同型——图标底块
        // bg-[<color>21]（13% alpha）/字形 text-[<color>] 双端同源）。
        var apps_names = [
            "011-calculator", "012-stopwatch", "013-todo", "014-weather",
            "015-notes", "017-chat", "018-book-reader", "020-music-player",
            "024-charts", "025-sys-monitor", "038-minesweeper", "041-auto-edit"
        ]
        var apps_titles = [
            "Calculator", "Stopwatch", "Todo", "Weather",
            "Notes", "Chat", "Books", "Music",
            "Charts", "系统监视器", "Minesweeper", "Auto Edit"
        ]
        var apps_icons = [
            "calculator", "timer", "check-square", "cloud-sun",
            "notebook-pen", "message-circle", "book-open", "music",
            "bar-chart-3", "activity", "bomb", "file-code"
        ]
        var apps_cats = [
            "tool", "tool", "task", "life",
            "notes", "social", "reading", "media",
            "data", "system", "game", "editor"
        ]
        var apps_colors = [
            "#7c9a6d", "#b88c61", "#6a8bad", "#7d9ec4",
            "#c9a77e", "#8d7ab5", "#a47551", "#c4706a",
            "#6fa3a7", "#9a8fb8", "#8a9b6e", "#5f8d78"
        ]
        var apps_lns = [
            "011-calculator", "012-stopwatch", "013-todo", "014-weather",
            "015-notes", "017-chat", "018-book-reader", "020-music-player",
            "024-charts", "025-sys-monitor", "038-minesweeper", "041-auto-edit"
        ]
        var apps_lts = [
            "calculator", "stopwatch", "todo", "weather",
            "notes", "chat", "books", "music",
            "charts", "sys-monitor", "minesweeper", "auto edit"
        ]
        var recent = []             // 启动名记录，最近在前，上限 5（storage 持久化）
        var last str = ""           // 最近一次启动（演示/断言锚）

        // ---- Quicklinks provider mock（独立模式；hosted 可注入）----
        var ql_ids = ["gh", "docs", "downloads"]
        var ql_titles = ["GitHub", "AutoOS Docs", "Downloads"]
        var ql_urls = ["https://github.com", "https://github.com/auto-stack/auto-os", "Downloads"]
        var ql_kinds = ["url", "url", "path"]
        var ql_lns = ["gh", "docs", "downloads"]
        var ql_lts = ["github", "autoos docs", "downloads"]
    }

    view {
        if .visible == "1" {
            if .mode == "palette" {
                // ---- palette 形态：语义 scrim + 顶部 1/4 处搜索卡（Plan 503
                // stella 化：bg-card/80 三件套 + 品牌色图标底块 + 分类胶囊）----
                // PLAN-010 N6d：外点关闭——scrim on_press 捕获，与 icon 菜单
                // ondismiss 同效（宿主 launcher_visible 直读 visible，零宿主改动）。
                mouse-area (onclick: .Close) {
                col {
                    style: "w-full h-full bg-background/60 flex flex-col items-center"
                    spacer { style: "h-24 w-full" }
                    // PLAN-010 N6d：卡片守卫——on_press 捕获吞掉卡片空白区点击
                    //（守卫动作 ApplyFilter 幂等纯重算，不动 sel/gsel），
                    // 点卡片不再落到 scrim（布局件 onclick=on_release 不捕获，不可作守卫）。
                    mouse-area (onclick: .ApplyFilter, style: "w-full max-w-xl") {
                    col {
                        style: "w-full bg-card/80 border rounded-2xl shadow-2xl overflow-hidden"

                        // 搜索行
                        row {
                            style: "flex items-center gap-2 px-4 py-3 border-b"
                            text "🔍" { style: "text-lg" }
                            input {
                                value: .q
                                oninput: .SetQ
                                // onenter 不绑 Pick：Enter 走 bind 层，避免
                                // Ctrl+Enter 开菜单后 keyup 再触发 Pick（P2-R04）
                                placeholder: "Search apps…"
                                style: "flex-1 text-lg text-foreground bg-background/50 rounded-lg px-2"
                            }
                        }

                        // 分类胶囊（Plan 503）：选中 = bg-primary/15 + text-primary
                        row {
                            style: "flex items-center gap-1 px-4 py-2 border-b"
                            // PLAN-526 T38：tag 统一为 all 同款可读样式
                            // （此前未选中 tag muted 前景在深底上不可读，
                            // 用户八轮反馈截图3）。
                            for c in .cats_visible {
                                button (text: c) {
                                    onclick: .PickCat(c)
                                    style: "h-6 px-2.5 text-xs rounded-full bg-primary/15 text-primary"
                                }
                            }
                        }

                        // 结果列表（加载/错误/空态 + 动作菜单）。
                        // PLAN-526 T38：max-h + overflow-y-auto——结果过多时
                        // VM 侧 build_scrollable cap 语义出滚动条。
                        col {
                            style: "w-full max-h-96 overflow-y-auto"
                            if .load_state == "loading" {
                                col {
                                    style: "flex flex-col items-center py-10"
                                    text "Searching…" { style: "text-muted-foreground text-sm" }
                                }
                            }
                            if .load_state == "error" {
                                col {
                                    style: "flex flex-col items-center py-10 gap-2"
                                    text "Search failed" { style: "text-destructive text-sm" }
                                    text .load_error { style: "text-muted-foreground text-xs" }
                                }
                            }
                            if .load_state == "empty" {
                                col {
                                    style: "flex flex-col items-center py-10"
                                    text "No matching apps" { style: "text-muted-foreground text-sm" }
                                }
                            }
                            if .load_state == "ready" {
                            if .nres == 0 {
                                col {
                                    style: "flex flex-col items-center py-10"
                                    text "No matching apps" { style: "text-muted-foreground text-sm" }
                                }
                            }
                            for r in .ranked {
                                if .sel == r.i {
                                    mouse-area (onclick: .Launch(r.name)) {
                                    row {
                                        // 2026-09-15：行容器 button→mouse-area+row——
                                        // iced button 内容行把子件高度钳到文本行高，
                                        // 40px 图标被压成横条（矩阵探针 A-E 实测：
                                        // 同结构 plain row 完美、button 全坏）；行
                                        // hover 类沿 PLAN-002 B 布局件消费。
                                        style: "w-full flex items-center gap-2 px-3 py-[18px] bg-primary/15 text-foreground cursor-pointer"
                                        // 用户裁定（2026-09-15，沿桌面 PLAN-018-FU2
                                        // 「保留原图圆角板、外框不要」）：iconfile
                                        // 位图自带圆角板——满幅渲染不再套 chip 外框；
                                        // 裸 lucide 字标保持品牌色 chip + glyph。
                                        // 2026-09-15 补：满幅臂必须套定尺寸 col——
                                        // icon 直接作 button 子件时 h-10/w-10 尺寸
                                        // 类失效（缩成原始小图，且挤乱行内居中）。
                                        // 二次修正：col 内 icon 也不能用 w-full/h-full
                                        //（iced 按钮内容行里 Fill 无定宽父级参照 =
                                        // 塌缩回原始小图），显式 h-10/w-10。
                                        if r.full == "1" {
                                            col {
                                                style: "h-10 w-10 flex items-center justify-center"
                                                icon (name: r.icon) { style: "h-10 w-10" }
                                            }
                                        } else {
                                            col {
                                                style: "h-10 w-10 rounded-xl flex items-center justify-center ${r.chip}"
                                                icon (name: r.icon) { style: "h-6 w-6" }
                                            }
                                        }
                                        col {
                                            style: "flex flex-col"
                                            text r.title { style: "text-primary text-sm font-medium" }
                                            text r.sub { style: "text-muted-foreground text-xs" }
                                        }
                                        text r.category { style: "ml-auto text-xs text-muted-foreground" }
                                    }
                                    }
                                } else {
                                    mouse-area (onclick: .Launch(r.name)) {
                                    row {
                                        // 行容器 mouse-area+row（同上选中行）。
                                        style: "w-full flex items-center gap-2 px-3 py-[18px] bg-transparent text-foreground hover:bg-primary/10 cursor-pointer"
                                        // 满幅/chip 分流（同上选中行；满幅臂定尺寸
                                        // col 包装同理——button 直接子 icon 丢尺寸，
                                        // col 内 icon 显式 h-10/w-10）。
                                        if r.full == "1" {
                                            col {
                                                style: "h-10 w-10 flex items-center justify-center"
                                                icon (name: r.icon) { style: "h-10 w-10" }
                                            }
                                        } else {
                                            col {
                                                style: "h-10 w-10 rounded-xl flex items-center justify-center ${r.chip}"
                                                icon (name: r.icon) { style: "h-6 w-6" }
                                            }
                                        }
                                        col {
                                            style: "flex flex-col"
                                            text r.title { style: "text-foreground text-sm" }
                                            text r.sub { style: "text-muted-foreground text-xs" }
                                        }
                                        text r.category { style: "ml-auto text-xs text-muted-foreground" }
                                    }
                                    }
                                }
                            }
                            }
                        }

                        // 动作菜单（P2-R04）：点击显式 kind；仅展示可用动作
                        if .actions_open == "1" {
                            col {
                                style: "w-full border-t bg-background/40"
                                text "Actions" { style: "px-4 pt-2 text-xs text-muted-foreground" }
                                if .action_sel == 0 {
                                    mouse-area (onclick: .RunActionKind("launch")) {
                                        row {
                                            style: "w-full px-4 py-2 bg-primary/15 cursor-pointer"
                                            text "Launch" { style: "text-sm text-primary" }
                                        }
                                    }
                                } else {
                                    mouse-area (onclick: .RunActionKind("launch")) {
                                        row {
                                            style: "w-full px-4 py-2 hover:bg-primary/10 cursor-pointer"
                                            text "Launch" { style: "text-sm text-foreground" }
                                        }
                                    }
                                }
                                if .sel_provider == "quicklinks" {
                                    if .action_sel == 1 {
                                        mouse-area (onclick: .RunActionKind("open")) {
                                            row {
                                                style: "w-full px-4 py-2 bg-primary/15 cursor-pointer"
                                                text "Open" { style: "text-sm text-primary" }
                                            }
                                        }
                                    } else {
                                        mouse-area (onclick: .RunActionKind("open")) {
                                            row {
                                                style: "w-full px-4 py-2 hover:bg-primary/10 cursor-pointer"
                                                text "Open" { style: "text-sm text-foreground" }
                                            }
                                        }
                                    }
                                }
                                text "Enter run · Esc close menu · target=(provider,result_id)" { style: "px-4 pb-2 text-xs text-muted-foreground" }
                            }
                        }

                        // 底部提示行
                        row {
                            style: "flex items-center gap-4 px-4 py-2 border-t"
                            text "↑↓ select" { style: "text-xs text-muted-foreground" }
                            text "Enter launch" { style: "text-xs text-muted-foreground" }
                            text "Ctrl+Enter actions" { style: "text-xs text-muted-foreground" }
                            mouse-area (onclick: .OpenActions) {
                                row {
                                    style: "h-7 px-2 rounded bg-primary/15 text-primary items-center"
                                    text "Actions" { style: "text-xs" }
                                }
                            }
                            text "Esc close" { style: "text-xs text-muted-foreground" }
                            text .partial_note { style: "text-xs text-destructive" }
                            text .count { style: "ml-auto text-xs text-muted-foreground" }
                        }
                    }
                    }
                    spacer { style: "h-24 w-full" }
                }
                }
            } else {
                // ---- grid 形态（P5）：图标网格（注册表序全量）+ 方向键焦点
                //（Plan 503：语义 scrim + 卡片三件套 + 品牌色瓦片）----
                // PLAN-010 N6d：外点关闭（同 palette 形态）。
                mouse-area (onclick: .Close) {
                col {
                    style: "w-full h-full bg-background/60 flex flex-col items-center"
                    spacer { style: "h-24 w-full" }
                    // PLAN-010 N6d：卡片守卫（同 palette 形态）。
                    mouse-area (onclick: .ApplyFilter, style: "w-full max-w-2xl") {
                    col {
                        style: "w-full bg-card/80 border rounded-2xl shadow-2xl p-6"
                        // PLAN-013 W2：grid 形态保留 search 行（与 palette
                        // 同一 input 绑定，Tab 切换后持焦不丢）。
                        row {
                            style: "flex items-center gap-2 px-4 py-3 border-b"
                            text "🔍" { style: "text-lg" }
                            input {
                                value: .q
                                oninput: .SetQ
                                placeholder: "Search apps…"
                                style: "flex-1 text-lg text-foreground bg-background/50 rounded-lg px-2"
                            }
                        }
                        row {
                            style: "flex items-center mb-4"
                            text "All apps" { style: "text-foreground text-sm" }
                            text .gcount { style: "ml-auto text-xs text-muted-foreground" }
                        }
                        // 2026-09-15 用户裁定：5 列（原 4 列横向过疏）+ 网格
                        // 区限高滚动——卡片总高不得超过任务栏，超出出滚动条
                        //（max-h + overflow-y-auto，palette 结果列同款机制）。
                        col {
                            style: "w-full max-h-[440px] overflow-y-auto"
                        grid {
                            cols: 5
                            gap: 3
                            for g in .gridrows {
                                if .gsel == g.gi {
                                    col {
                                        onclick: .Launch(g.name)
                                        style: "flex flex-col items-center gap-2 p-3 rounded-xl bg-primary/15 cursor-pointer"
                                        // 用户裁定（2026-09-15，沿桌面 PLAN-018-FU2
                                        // 「保留原图圆角板、外框不要」）：iconfile
                                        // 位图自带圆角板——满幅渲染不再套 chip 外框
                                        //（原 h-7 位图居中在 48px chip 里显小）；
                                        // 裸 lucide 字标保持品牌色 chip + glyph。
                                        if g.full == "1" {
                                            icon (name: g.icon) { style: "h-12 w-12" }
                                        } else {
                                            col {
                                                style: "h-12 w-12 rounded-xl flex items-center justify-center ${g.chip}"
                                                icon (name: g.icon) { style: "h-7 w-7" }
                                            }
                                        }
                                        text g.title { style: "text-primary text-xs text-center" }
                                    }
                                } else {
                                    col {
                                        onclick: .Launch(g.name)
                                        // PLAN-002 B：布局件 hover 类消费（此前 col
                                        // 的 hover: 静默丢弃——526 Q9① 实测网格态
                                        // 无高亮；VM 轨现与 Vue 原生 :hover 同效）。
                                        style: "flex flex-col items-center gap-2 p-3 rounded-xl hover:bg-primary/10 cursor-pointer"
                                        // 满幅/chip 分流（同上聚焦格）。
                                        if g.full == "1" {
                                            icon (name: g.icon) { style: "h-12 w-12" }
                                        } else {
                                            col {
                                                style: "h-12 w-12 rounded-xl flex items-center justify-center ${g.chip}"
                                                icon (name: g.icon) { style: "h-7 w-7" }
                                            }
                                        }
                                        text g.title { style: "text-foreground text-xs text-center" }
                                    }
                                }
                            }
                        }
                        }
                        row {
                            style: "flex items-center gap-4 mt-4 pt-3 border-t"
                            text "↑↓←→ move" { style: "text-xs text-muted-foreground" }
                            text "Enter launch" { style: "text-xs text-muted-foreground" }
                            text "Tab palette" { style: "text-xs text-muted-foreground" }
                        }
                    }
                    }
                    spacer { style: "h-24 w-full" }
                }
                }
            }
        } else {
            // ---- 隐藏态：透明空层（desktop 不挡桌面点击；独立模式给开门按钮
            //（Plan 503：语义 token 化））----
            col {
                style: "w-full h-full"
                if .hosted == "0" {
                    row {
                        style: "w-full h-full flex flex-col items-center justify-center bg-background gap-4"
                        button "🔍 Open launcher (Ctrl+Space · IME 机 Ctrl+Alt+Space)" {
                            onclick: .Open
                            style: "px-4 py-2 bg-primary text-primary-foreground rounded-xl shadow"
                        }
                        // AC-04：standalone mock 显式标识为开发 fixture
                        text "dev fixture · standalone mock registry" { style: "text-xs text-muted-foreground" }
                        // R-01/R-03：provider 失败注入（开发夹具；触发隔离与 error 态）
                        row {
                            style: "flex items-center gap-2"
                            button "Fail apps" {
                                onclick: .SetAppsOk("0")
                                style: "px-2 py-1 text-xs rounded bg-destructive/20 text-destructive"
                            }
                            button "Fail quicklinks" {
                                onclick: .SetQlOk("0")
                                style: "px-2 py-1 text-xs rounded bg-destructive/20 text-destructive"
                            }
                            button "Restore providers" {
                                onclick: .RestoreProviders
                                style: "px-2 py-1 text-xs rounded bg-primary/20 text-primary"
                            }
                        }
                        if .last != "" {
                            text f"Last launched: ${.last}" { style: "text-sm text-muted-foreground" }
                        }
                    }
                }
            }
        }
    }

    bind {
        "ArrowUp" -> .MoveUp
        "ArrowDown" -> .MoveDown
        "ArrowLeft" -> .MoveLeft
        "ArrowRight" -> .MoveRight
        "Enter" -> .Pick
        "Escape" -> .Escape
        "Tab" -> .SwitchMode
        "Ctrl+Enter" -> .OpenActions
        "Ctrl+ " -> .Open
    }

    on {
        .Init -> {
            .q = ""
            .sel = 0
            .gsel = 0
            .mode = "palette"
            .visible = "0"
            .cat = "all"
            // recent 持久化恢复（018/025 storage 先例）。定长 5 槽键：
            // storage.get → localStorage.getItem 产出 string|null，vue 生成码
            // 不带 ?? ''，对结果调方法会 TS18047 —— 槽值只做 != "" 比较（实测）。
            var r0 = storage.get("launcher.recent_apps.0")
            if r0 != "" { .recent.push(r0) }
            var r1 = storage.get("launcher.recent_apps.1")
            if r1 != "" { .recent.push(r1) }
            var r2 = storage.get("launcher.recent_apps.2")
            if r2 != "" { .recent.push(r2) }
            var r3 = storage.get("launcher.recent_apps.3")
            if r3 != "" { .recent.push(r3) }
            var r4 = storage.get("launcher.recent_apps.4")
            if r4 != "" { .recent.push(r4) }
            .ApplyFilter()
        }

        .Open -> {
            .visible = "1"
            .mode = "palette"
            .sel = 0
            .sel_result_id = ""
            .actions_open = "0"
            .load_state = "ready"
            .__focus_input = "1"
            .query_id = .query_id + 1
            .active_query_id = .query_id
            .ApplyFilter()
        }

        .Close -> {
            .visible = "0"
            .actions_open = "0"
        }

        .SetQ(t) -> {
            .q = t
            // P2-R05：生产接收门——分发 id 与当前 query_id 绑定
            .query_id = .query_id + 1
            .active_query_id = .query_id
            .load_state = "loading"
            if .nres > 0 {
                if .sel < .nres {
                    .sel_result_id = .ranked[.sel].name
                    .sel_provider = .ranked[.sel].provider
                    .sel_target = .ranked[.sel].target
                }
            }
            .ApplyFilter()
        }

        // Plan 503 分类胶囊：切分类 → 焦点复位重排。
        .PickCat(c) -> {
            .cat = c
            .sel = 0
            .ApplyFilter()
        }

        // 模糊排序（纯状态变换；规则 = SPEC.md「排序」节的唯一实现）：
        // 空查询 → recent 置顶分组 + 注册表序全量；非空 → 打分
        // exact(0) > prefix(1) > 词首(2) > 子序列(3)，同分按注册表序，
        // recent 在同档内前移（折扣 5..1，不足以跨档）。
        //
        // 实现注记（464 T4）：注册表注入/存储形态为平行字符串列表
        // （apps_names/titles/icons/cats/lns/lts）——Obj 数组的 VM handler
        // 字段读失效（B12 同族，探针测试钉死），字符串列表下标读保真；
        // ranked/gridrows 行对象为 handler 自建（view 侧读取已证可用）。
        .ApplyFilter -> {
            // PLAN-013 W2：零结果分类隐藏（注册表计数过滤）。
            .RebuildCats()
            .ranked = []
            .nres = 0
            // R-01/R-03/P2-R03：每次重算按 enabled/health 派生负载态
            .partial_note = ""
            var apps_on int = 0
            var ql_on int = 0
            if .apps_ok == "1" {
                apps_on = 1
            }
            if .ql_ok == "1" {
                ql_on = 1
            }
            if apps_on == 0 {
                if ql_on == 0 {
                    .load_state = "error"
                    .load_error = "all providers failed"
                } else {
                    .partial_note = "apps unavailable"
                    if .load_state == "error" {
                        .load_state = "ready"
                        .load_error = ""
                    }
                }
            } else {
                if ql_on == 0 {
                    .partial_note = "quicklinks unavailable"
                } else {
                    .partial_note = ""
                }
                if .load_state == "error" {
                    .load_state = "ready"
                    .load_error = ""
                }
            }
            var ql str = .q.lower()
            var napps int = .apps_names.len()
            // 双失败：不进列表构建
            if .apps_ok == "0" {
                if .ql_ok == "0" {
                    .nres = 0
                    .count = "0 apps"
                    return
                }
            }

            if ql == "" {
                // —— 空查询：recent + 注册表序 + quicklinks（按 provider 健康过滤）——
                var ri int = 0
                while ri < .recent.len() {
                    var ai int = 0
                    while ai < napps {
                        if .apps_ok == "1" {
                        if .apps_names[ai] == .recent[ri] {
                            if .cat == "all" || .apps_cats[ai] == .cat {
                                // full = iconfile 位图旗标（view 满幅渲染、免 chip 外框）
                                var ic1 str = .apps_icons[ai]
                                var f1 str = ""
                                if ic1.len() >= 9 {
                                    if ic1.slice(0, 9) == "iconfile:" {
                                        f1 = "1"
                                    }
                                }
                                var row = { i: .ranked.len(), name: .apps_names[ai], title: .apps_titles[ai], icon: ic1, category: .apps_cats[ai], mg: .apps_titles[ai].slice(0, 1), sub: "recent", chip: "bg-[" + .apps_colors[ai] + "21]", tchip: "text-[" + .apps_colors[ai] + "]", full: f1, provider: "apps", target: .apps_names[ai] }
                                .ranked.push(row)
                            }
                        }
                        }
                        ai = ai + 1
                    }
                    ri = ri + 1
                }
                var ak int = 0
                while ak < napps {
                    var seen int = 0
                    var rj int = 0
                    while rj < .recent.len() {
                        if .recent[rj] == .apps_names[ak] {
                            seen = 1
                        }
                        rj = rj + 1
                    }
                    if seen == 0 {
                        if .apps_ok == "1" {
                        if .cat == "all" || .apps_cats[ak] == .cat {
                            var ic2 str = .apps_icons[ak]
                            var f2 str = ""
                            if ic2.len() >= 9 {
                                if ic2.slice(0, 9) == "iconfile:" {
                                    f2 = "1"
                                }
                            }
                            var row2 = { i: .ranked.len(), name: .apps_names[ak], title: .apps_titles[ak], icon: ic2, category: .apps_cats[ak], mg: .apps_titles[ak].slice(0, 1), sub: .apps_cats[ak], chip: "bg-[" + .apps_colors[ak] + "21]", tchip: "text-[" + .apps_colors[ak] + "]", full: f2, provider: "apps", target: .apps_names[ak] }
                            .ranked.push(row2)
                        }
                        }
                    }
                    ak = ak + 1
                }
                // Quicklinks（空查询追加；失败/停用整段跳过）
                if .ql_ok == "1" {
                    var qi int = 0
                    while qi < .ql_ids.len() {
                        var qrow = { i: .ranked.len(), name: .ql_ids[qi], title: .ql_titles[qi], icon: "link", category: "link", mg: .ql_titles[qi].slice(0, 1), sub: .ql_kinds[qi], chip: "bg-[#6fa3a721]", tchip: "text-[#6fa3a7]", full: "", provider: "quicklinks", target: .ql_urls[qi] }
                        .ranked.push(qrow)
                        qi = qi + 1
                    }
                }
            } else {
                // —— 打分：score = tier*100 + 注册表序 - recent 折扣 ——
                var scored = []
                var nsc int = napps
                if .apps_ok == "0" {
                    nsc = 0
                }
                var si int = 0
                while si < nsc {
                    var ln str = .apps_lns[si]
                    var lt str = .apps_lts[si]
                    var tier int = 99

                    if ln == ql || lt == ql {
                        tier = 0
                    }
                    if tier == 99 {
                        // 前缀
                        if lt.len() >= ql.len() {
                            if lt.slice(0, ql.len()) == ql {
                                tier = 1
                            }
                        }
                    }
                    if tier == 99 {
                        // 前缀（id 同档——PLAN-015 回归修复：展示名转中文
                        // （title_zh locale 链）后 lt 失去拉丁形态，"term"
                        // 等 id 子串查询仅剩整 id 精确匹配可命中；ln=id
                        // 预小写键宿主恒注入（renderer 464 接缝），补入
                        // 三档模糊。)
                        if ln.len() >= ql.len() {
                            if ln.slice(0, ql.len()) == ql {
                                tier = 1
                            }
                        }
                    }
                    if tier == 99 {
                        // 词首（位置 0 或 空格/-/_ 之后）
                        var p int = 0
                        while p < lt.len() {
                            var hit int = 0
                            if p == 0 {
                                hit = 1
                            } else {
                                var pc str = lt.slice(p - 1, p)
                                if pc == " " || pc == "-" || pc == "_" {
                                    hit = 1
                                }
                            }
                            if hit == 1 {
                                if lt.len() - p >= ql.len() {
                                    if lt.slice(p, p + ql.len()) == ql {
                                        tier = 2
                                    }
                                }
                            }
                            p = p + 1
                        }
                    }
                    if tier == 99 {
                        // 词首（id 同档——"term" 命中 "auto-term" 的 '-' 后词首）
                        var p2 int = 0
                        while p2 < ln.len() {
                            var hit2 int = 0
                            if p2 == 0 {
                                hit2 = 1
                            } else {
                                var pc2 str = ln.slice(p2 - 1, p2)
                                if pc2 == " " || pc2 == "-" || pc2 == "_" {
                                    hit2 = 1
                                }
                            }
                            if hit2 == 1 {
                                if ln.len() - p2 >= ql.len() {
                                    if ln.slice(p2, p2 + ql.len()) == ql {
                                        tier = 2
                                    }
                                }
                            }
                            p2 = p2 + 1
                        }
                    }
                    if tier == 99 {
                        // 子序列（双指针）
                        var qi int = 0
                        var sj int = 0
                        while sj < lt.len() {
                            if qi < ql.len() {
                                if lt.slice(sj, sj + 1) == ql.slice(qi, qi + 1) {
                                    qi = qi + 1
                                }
                            }
                            sj = sj + 1
                        }
                        if qi == ql.len() {
                            tier = 3
                        }
                    }
                    if tier == 99 {
                        // 子序列（id 同档）
                        var qi2 int = 0
                        var sj2 int = 0
                        while sj2 < ln.len() {
                            if qi2 < ql.len() {
                                if ln.slice(sj2, sj2 + 1) == ql.slice(qi2, qi2 + 1) {
                                    qi2 = qi2 + 1
                                }
                            }
                            sj2 = sj2 + 1
                        }
                        if qi2 == ql.len() {
                            tier = 3
                        }
                    }

                    var score int = tier * 1000000 + si + 16
                    if tier < 99 {
                        // recent 折扣：最近者折扣最大（5..1），仅同层内前移
                        var rk int = 0
                        while rk < .recent.len() {
                            if .recent[rk] == ln {
                                var disc int = 5 - rk
                                if disc < 1 {
                                    disc = 1
                                }
                                score = score - disc
                            }
                            rk = rk + 1
                        }
                    } else {
                        score = 99000000
                    }
                    var srow = { name: .apps_names[si], title: .apps_titles[si], icon: .apps_icons[si], category: .apps_cats[si], score: score, color: .apps_colors[si], provider: "apps", target: .apps_names[si] }
                    scored.push(srow)
                    si = si + 1
                }

                // Quicklinks 打分（provider_ok 才入列；与 apps 同 score 公式）
                if .ql_ok == "1" {
                    var qsi int = 0
                    var nql int = .ql_ids.len()
                    while qsi < nql {
                        var qln str = .ql_lns[qsi]
                        var qlt str = .ql_lts[qsi]
                        var qtier int = 99
                        if qln == ql || qlt == ql {
                            qtier = 0
                        }
                        if qtier == 99 {
                            if qlt.len() >= ql.len() {
                                if qlt.slice(0, ql.len()) == ql {
                                    qtier = 1
                                }
                            }
                        }
                        if qtier == 99 {
                            if qln.len() >= ql.len() {
                                if qln.slice(0, ql.len()) == ql {
                                    qtier = 1
                                }
                            }
                        }
                        if qtier == 99 {
                            // 词首（与 apps 同规则）
                            var qp int = 0
                            while qp < qlt.len() {
                                var qhit int = 0
                                if qp == 0 {
                                    qhit = 1
                                } else {
                                    var qpc str = qlt.slice(qp - 1, qp)
                                    if qpc == " " || qpc == "-" || qpc == "_" {
                                        qhit = 1
                                    }
                                }
                                if qhit == 1 {
                                    if qlt.len() - qp >= ql.len() {
                                        if qlt.slice(qp, qp + ql.len()) == ql {
                                            qtier = 2
                                        }
                                    }
                                }
                                qp = qp + 1
                            }
                        }
                        if qtier == 99 {
                            var qqi int = 0
                            var qsj int = 0
                            while qsj < qlt.len() {
                                if qqi < ql.len() {
                                    if qlt.slice(qsj, qsj + 1) == ql.slice(qqi, qqi + 1) {
                                        qqi = qqi + 1
                                    }
                                }
                                qsj = qsj + 1
                            }
                            if qqi == ql.len() {
                                qtier = 3
                            }
                        }
                        // P2-R01：与 apps 同一 score_key（无 +1000 偏置）
                        var qscore int = qtier * 1000000 + qsi + 16
                        if qtier >= 99 {
                            qscore = 99000000
                        }
                        var qsrow = { name: .ql_ids[qsi], title: .ql_titles[qsi], icon: "link", category: "link", score: qscore, color: "#6fa3a7", provider: "quicklinks", target: .ql_urls[qsi] }
                        scored.push(qsrow)
                        qsi = qsi + 1
                    }
                }

                // 选择排序输出（score_key 升序；99000000 = 不匹配；
                // 同 key 按注册序 si 稳定）。
                var n int = scored.len()
                var used = []
                var u int = 0
                while u < n {
                    used.push(0)
                    u = u + 1
                }
                var placed int = 0
                while placed < n {
                    var best int = -1
                    var bestScore int = 0
                    var bi int = 0
                    while bi < n {
                        if used[bi] == 0 {
                            var sc int = scored[bi].score
                            if sc < 99000000 {
                                if best == -1 {
                                    best = bi
                                    bestScore = sc
                                } else {
                                    if sc < bestScore {
                                        best = bi
                                        bestScore = sc
                                    }
                                }
                            }
                        }
                        bi = bi + 1
                    }
                    if best == -1 {
                        placed = n
                    } else {
                        // Plan 503：非选中分类不出列（分数序保持稳定）。
                        if .cat == "all" || scored[best].category == .cat {
                            var ic3 str = scored[best].icon
                            var f3 str = ""
                            if ic3.len() >= 9 {
                                if ic3.slice(0, 9) == "iconfile:" {
                                    f3 = "1"
                                }
                            }
                            var row3 = { i: .ranked.len(), name: scored[best].name, title: scored[best].title, icon: ic3, category: scored[best].category, mg: scored[best].title.slice(0, 1), sub: scored[best].category, chip: "bg-[" + scored[best].color + "21]", tchip: "text-[" + scored[best].color + "]", full: f3, provider: scored[best].provider, target: scored[best].target }
                            .ranked.push(row3)
                        }
                        used[best] = 1
                        placed = placed + 1
                    }
                }
            }

            .nres = .ranked.len()
            // 选中保持（AC-03）：按 result_id（=name）而非旧行号
            if .nres == 0 {
                .count = "0 apps"
                .load_state = "empty"
                .sel_result_id = ""
            } else {
                if .load_state == "loading" {
                    .load_state = "ready"
                }
                if .load_state == "empty" {
                    .load_state = "ready"
                }
                var keep int = -1
                var ki int = 0
                while ki < .nres {
                    if .ranked[ki].name == .sel_result_id {
                        if .ranked[ki].provider == .sel_provider {
                            keep = ki
                        }
                    }
                    ki = ki + 1
                }
                if keep >= 0 {
                    .sel = keep
                    .sel_result_id = .ranked[keep].name
                    .sel_provider = .ranked[keep].provider
                    .sel_target = .ranked[keep].target
                } else {
                    // P2-R02：目标消失回落首项，旧动作目标失效
                    if .sel >= .nres {
                        .sel = .nres - 1
                    }
                    if .sel < 0 {
                        .sel = 0
                    }
                    .sel_result_id = .ranked[.sel].name
                    .sel_provider = .ranked[.sel].provider
                    .sel_target = .ranked[.sel].target
                    .actions_open = "0"
                }
                var idx int = .sel + 1
                .count = f"${idx} / ${.nres} apps"
            }

            // 网格行（P2-R03/R3-01）：遵循 provider 门——apps 停用/失败不出列
            .gridrows = []
            if .apps_ok == "1" {
                var gi2 int = 0
                while gi2 < napps {
                    var ic4 str = .apps_icons[gi2]
                    var f4 str = ""
                    if ic4.len() >= 9 {
                        if ic4.slice(0, 9) == "iconfile:" {
                            f4 = "1"
                        }
                    }
                    var row4 = { gi: .gridrows.len(), name: .apps_names[gi2], title: .apps_titles[gi2], icon: ic4, mg: .apps_titles[gi2].slice(0, 1), category: .apps_cats[gi2], chip: "bg-[" + .apps_colors[gi2] + "21]", tchip: "text-[" + .apps_colors[gi2] + "]", full: f4, provider: "apps", target: .apps_names[gi2] }
                    .gridrows.push(row4)
                    gi2 = gi2 + 1
                }
            }
            // quicklinks 进 grid（与 palette 同门）
            if .ql_ok == "1" {
                var gqi int = 0
                while gqi < .ql_ids.len() {
                    var qrow4 = { gi: .gridrows.len(), name: .ql_ids[gqi], title: .ql_titles[gqi], icon: "link", mg: .ql_titles[gqi].slice(0, 1), category: "link", chip: "bg-[#6fa3a721]", tchip: "text-[#6fa3a7]", full: "", provider: "quicklinks", target: .ql_urls[gqi] }
                    .gridrows.push(qrow4)
                    gqi = gqi + 1
                }
            }
            if .gridrows.len() > 0 {
                if .gsel >= .gridrows.len() {
                    .gsel = .gridrows.len() - 1
                }
                var gi3 int = .gsel + 1
                .gcount = f"${gi3} / ${.gridrows.len()} apps"
            } else {
                .gcount = "0 apps"
            }
        }

        .MoveUp -> {
            if .visible == "1" {
            if .actions_open == "1" {
                .MoveActionUp()
            } else {
            if .mode == "palette" {
                if .nres > 0 {
                    if .sel > 0 {
                        .sel = .sel - 1
                    } else {
                        .sel = .nres - 1
                    }
                    if .sel < .nres {
                        .sel_result_id = .ranked[.sel].name
                        .sel_provider = .ranked[.sel].provider
                        .sel_target = .ranked[.sel].target
                    }
                    .ApplyFilter()
                }
            } else {
                // grid：上移一行（cols=4），列内回绕
                var n2 int = .gridrows.len()
                if n2 > 0 {
                    var g int = .gsel
                    if g < 4 {
                        g = g - 4 + n2
                    } else {
                        g = g - 4
                    }
                    .gsel = g
                    .ApplyFilter()
                }
            }
            }
            }
        }

        .MoveDown -> {
            if .visible == "1" {
            if .actions_open == "1" {
                .MoveActionDown()
            } else {
            if .mode == "palette" {
                if .nres > 0 {
                    if .sel < .nres - 1 {
                        .sel = .sel + 1
                    } else {
                        .sel = 0
                    }
                    if .sel < .nres {
                        .sel_result_id = .ranked[.sel].name
                        .sel_provider = .ranked[.sel].provider
                        .sel_target = .ranked[.sel].target
                    }
                    .ApplyFilter()
                }
            } else {
                var n3 int = .gridrows.len()
                if n3 > 0 {
                    var g2 int = .gsel + 4
                    if g2 >= n3 {
                        g2 = g2 - n3
                    }
                    .gsel = g2
                    .ApplyFilter()
                }
            }
            }
            }
        }

        .MoveLeft -> {
            if .visible == "1" {
            if .mode == "grid" {
                var n4 int = .gridrows.len()
                if n4 > 0 {
                    var g3 int = .gsel
                    if g3 == 0 {
                        g3 = n4 - 1
                    } else {
                        g3 = g3 - 1
                    }
                    .gsel = g3
                    .ApplyFilter()
                }
            }
            }
        }

        .MoveRight -> {
            if .visible == "1" {
            if .mode == "grid" {
                var n5 int = .gridrows.len()
                if n5 > 0 {
                    var g4 int = .gsel + 1
                    if g4 >= n5 {
                        g4 = 0
                    }
                    .gsel = g4
                    .ApplyFilter()
                }
            }
            }
        }

        // Enter：启动当前焦点项（按 result_id/实体键；IME 组合中不触发）
        .Pick -> {
            if .visible == "1" {
            if .ime_composing == "1" {
                // R-02/L03：组合中 Enter 交输入法，不启动
            } else {
            if .actions_open == "1" {
                .RunAction()
            } else {
            if .mode == "palette" {
                if .nres > 0 {
                    if .sel < .nres {
                        .sel_result_id = .ranked[.sel].name
                        .sel_provider = .ranked[.sel].provider
                        .sel_target = .ranked[.sel].target
                        .Launch(.ranked[.sel].name)
                    }
                }
            } else {
                if .gridrows.len() > 0 {
                    if .gsel < .gridrows.len() {
                        .sel_provider = .gridrows[.gsel].provider
                        .sel_result_id = .gridrows[.gsel].name
                        .sel_target = .gridrows[.gsel].target
                        .Launch(.gridrows[.gsel].name)
                    }
                }
            }
            }
            }
            }
        }

        // Esc 逐层退出（P3）：组合中交输入法 → 关动作菜单 → 清词 → 退 grid → 关闭
        .Escape -> {
            if .visible == "1" {
            if .ime_composing == "1" {
                // R-02/L03：组合中 Esc 交输入法
            } else {
            if .actions_open == "1" {
                .actions_open = "0"
            } else {
            if .q != "" {
                .q = ""
                .sel = 0
                .sel_result_id = ""
                .query_id = .query_id + 1
                .active_query_id = .query_id
                .ApplyFilter()
            } else {
                if .mode == "grid" {
                    .mode = "palette"
                } else {
                    .visible = "0"
                }
            }
            }
            }
            }
        }

        .SetImeComposing(v) -> {
            .ime_composing = v
        }

        // 动作菜单（T-03/T-10）：Ctrl+Enter 打开；目标 = 选中完整身份
        .OpenActions -> {
            if .visible == "1" {
                if .nres > 0 {
                    .actions_open = "1"
                    .action_sel = 0
                    if .sel < .nres {
                        .sel_result_id = .ranked[.sel].name
                        .sel_provider = .ranked[.sel].provider
                        .sel_target = .ranked[.sel].target
                    }
                }
            }
        }

        // P2-R04：菜单点击/键盘共用显式 kind 执行入口
        .RunActionKind(k) -> {
            if .actions_open == "1" {
                var target str = .sel_result_id
                var prov str = .sel_provider
                var tref str = .sel_target
                if target == "" {
                    if .nres > 0 {
                        if .sel < .nres {
                            target = .ranked[.sel].name
                            prov = .ranked[.sel].provider
                            tref = .ranked[.sel].target
                        }
                    }
                }
                if target == "" {
                    // 旧动作目标失效 → 拒绝
                    .actions_open = "0"
                } else {
                    if k == "launch" {
                        .sel_provider = prov
                        .sel_target = tref
                        .Launch(target)
                    } else {
                        if k == "open" {
                            if prov == "quicklinks" {
                                .last = target
                                .__desktop_cmd = "open\t" + tref
                                .actions_open = "0"
                                .visible = "0"
                            } else {
                                // apps 无 open → 拒绝无效动作
                                .actions_open = "0"
                            }
                        } else {
                            .actions_open = "0"
                        }
                    }
                }
            }
        }

        .RunAction -> {
            if .action_sel == 0 {
                .RunActionKind("launch")
            } else {
                .RunActionKind("open")
            }
        }

        .MoveActionUp -> {
            if .actions_open == "1" {
                if .action_sel > 0 {
                    .action_sel = .action_sel - 1
                } else {
                    .action_sel = 1
                }
            }
        }

        .MoveActionDown -> {
            if .actions_open == "1" {
                if .action_sel < 1 {
                    .action_sel = .action_sel + 1
                } else {
                    .action_sel = 0
                }
            }
        }

        // Tab：palette ↔ grid
        // PLAN-013 W2：可见分类重建——注册表计数 >0 的分类才出 tag。
        .RebuildCats -> {
            .cats_visible = ["all"]
            var ci int = 0
            while ci < .cats.len() {
                var c = .cats[ci]
                if c != "all" {
                    var cnt int = 0
                    var ai int = 0
                    while ai < .apps_names.len() {
                        if .apps_cats[ai] == c {
                            cnt = cnt + 1
                        }
                        ai = ai + 1
                    }
                    if cnt > 0 {
                        .cats_visible.push(c)
                    }
                }
                ci = ci + 1
            }
        }

        .SwitchMode -> {
            if .mode == "palette" {
                .mode = "grid"
            } else {
                .mode = "palette"
            }
            // PLAN-013 W2：切视图后 search input 重建——重新请求聚焦。
            .__focus_input = "1"
        }

        // 启动（R11）：写上行总线 + recent + 隐匿。
        // desktop 模式宿主排空 `__desktop_cmd` 执行 LaunchApp；独立模式
        // 总线无人消费，仅演示（441 fallback 边界）。
        .Launch(name) -> {
            .last = name
            // P2-R02：从选中结果的 provider/target 路由，不扫描其他 provider
            var is_ql int = 0
            var target str = name
            if .sel_provider == "quicklinks" {
                is_ql = 1
                target = .sel_target
                if target == "" {
                    target = name
                }
            }
            if .sel_provider == "apps" {
                is_ql = 0
                target = name
            }
            // recent：存完整可恢复键 provider:entity（旧无前缀数据兼容）
            var rec_key str = name
            if .sel_provider == "quicklinks" {
                rec_key = "ql:" + name
            }
            var nr = []
            nr.push(rec_key)
            var oi int = 0
            while oi < .recent.len() {
                if nr.len() < 5 {
                    if .recent[oi] != rec_key {
                        nr.push(.recent[oi])
                    }
                }
                oi = oi + 1
            }
            .recent = nr
            if nr.len() > 0 { storage.set("launcher.recent_apps.0", nr[0]) } else { storage.set("launcher.recent_apps.0", "") }
            if nr.len() > 1 { storage.set("launcher.recent_apps.1", nr[1]) } else { storage.set("launcher.recent_apps.1", "") }
            if nr.len() > 2 { storage.set("launcher.recent_apps.2", nr[2]) } else { storage.set("launcher.recent_apps.2", "") }
            if nr.len() > 3 { storage.set("launcher.recent_apps.3", nr[3]) } else { storage.set("launcher.recent_apps.3", "") }
            if nr.len() > 4 { storage.set("launcher.recent_apps.4", nr[4]) } else { storage.set("launcher.recent_apps.4", "") }
            if is_ql == 1 {
                .__desktop_cmd = "open\t" + target
            } else {
                .__desktop_cmd = "launch\t" + name
            }
            .visible = "0"
            .actions_open = "0"
            .q = ""
            .sel = 0
            .sel_result_id = ""
            .sel_provider = ""
            .sel_target = ""
            .query_id = .query_id + 1
            .active_query_id = .query_id
            .ApplyFilter()
        }

        // R-01：provider 健康位（"1"=ok / "0"=fail）；驱动失败隔离与 error 态
        .SetAppsOk(v) -> {
            .apps_ok = v
            .ApplyFilter()
        }

        .SetQlOk(v) -> {
            .ql_ok = v
            .ApplyFilter()
        }

        .RestoreProviders -> {
            .apps_ok = "1"
            .ql_ok = "1"
            .ApplyFilter()
        }

        // P2-R05/T-08：生产接收门（与 dispatch.receive_provider 同语义）。
        // inbound 形如 "1"（query_id 字符串）或 "1:ok"/"1:fail"。
        .ReceiveProvider(inbound) -> {
            var sid str = inbound
            var ok_flag str = "ok"
            var colon int = 0
            var ci int = 0
            while ci < inbound.len() {
                if inbound.slice(ci, ci + 1) == ":" {
                    colon = 1
                }
                ci = ci + 1
            }
            if colon == 1 {
                // 取冒号前为 id，后为 ok|fail
                var cut int = 0
                var cj int = 0
                while cj < inbound.len() {
                    if inbound.slice(cj, cj + 1) == ":" {
                        cut = cj
                    }
                    cj = cj + 1
                }
                sid = inbound.slice(0, cut)
                ok_flag = inbound.slice(cut + 1, inbound.len())
            }
            // 过期/取消丢弃：inbound id != active_query_id
            var iid int = 0
            var kk int = 0
            while kk < sid.len() {
                let ch = sid.slice(kk, kk + 1)
                if ch == "0" { iid = iid * 10 + 0 }
                if ch == "1" { iid = iid * 10 + 1 }
                if ch == "2" { iid = iid * 10 + 2 }
                if ch == "3" { iid = iid * 10 + 3 }
                if ch == "4" { iid = iid * 10 + 4 }
                if ch == "5" { iid = iid * 10 + 5 }
                if ch == "6" { iid = iid * 10 + 6 }
                if ch == "7" { iid = iid * 10 + 7 }
                if ch == "8" { iid = iid * 10 + 8 }
                if ch == "9" { iid = iid * 10 + 9 }
                kk = kk + 1
            }
            if iid == .active_query_id {
                if ok_flag == "fail" {
                    .apps_ok = "0"
                }
                .ApplyFilter()
            }
        }
    }
}

// test_fixture_scale.at — AC-01/AC-06 千条唯一身份与层级优先排序（P2-R01/R06）。
// 运行：auto test -d tests/test_fixture_scale.at -v
// 跨模块调用 score_entity_key（同模块紧循环会触发 VM str 池缺陷）。

use auto.test: assert_eq, assert_true
use src.core.query: score_entity_key, score_key, match_tier_one, sort_indices, is_match

fn title_at(i int) str {
    let m = i % 7
    if m == 0 { return "Calculator" }
    if m == 1 { return "计算器" }
    if m == 2 { return "System Monitor" }
    if m == 3 { return "系统监视器" }
    if m == 4 { return "Auto Edit" }
    return "Notes"
}

/// 唯一实体键：id0..id999
fn id_at(i int) str {
    return "id" + f"$i"
}

fn pick_order(scores List) List {
    let n = scores.len()
    let used = List.new()
    var u = 0
    while u < n {
        used.push(0)
        u = u + 1
    }
    let seq = List.new()
    var placed = 0
    while placed < n {
        var best = -1
        var best_sc = 0
        var bi = 0
        while bi < n {
            if used.get(bi) == 0 {
                let sc = scores.get(bi)
                if sc < 99000000 {
                    if best == -1 {
                        best = bi
                        best_sc = sc
                    } else {
                        if sc < best_sc {
                            best = bi
                            best_sc = sc
                        }
                    }
                }
            }
            bi = bi + 1
        }
        if best == -1 {
            placed = n
        } else {
            seq.push(best)
            used.set(best, 1)
            placed = placed + 1
        }
    }
    return seq
}

#[test]
fn t_ac06_unique_ids_and_tier_order() {
    // 1000 个唯一实体键（不持有全部字符串，规避 VM 池）；
    // 排序用合成 score_key，验证层级优先与确定性。
    var prev = id_at(0)
    var si = 1
    while si < 1000 {
        let cur = id_at(si)
        if cur != prev {
            assert_eq(1, 1)
        } else {
            assert_eq(1, 0)
        }
        prev = cur
        si = si + 1
    }

    // 合成 1000 个 score_key：tier 循环 0..3，si 递增；固定预期 = 全 tier0 后 tier1…
    let scores = List.new()
    let t = 0
    var j = 0
    while j < 1000 {
        let tier = j % 4
        // 交错 si：高 si 的低 tier 应排前
        let sc = score_key(tier, 999 - (j / 4), 0)
        scores.push(sc)
        j = j + 1
    }
    let seq1 = pick_order(scores)
    let seq2 = pick_order(scores)
    if seq1.len() == 1000 {
        assert_eq(1, 1)
    } else {
        assert_eq(seq1.len(), 1000)
    }
    var t2 = 0
    while t2 < seq1.len() {
        assert_eq(seq1.get(t2), seq2.get(t2))
        t2 = t2 + 1
    }
    // 首个必须是某条 tier0（score_key < 1000000）
    let first_sc = scores.get(seq1.get(0))
    if first_sc < 1000000 {
        assert_eq(1, 1)
    } else {
        assert_eq(1, 0)
    }
}

#[test]
fn t_p2r01_fixed_expected_cross_tier() {
    // 固定预期：Downloads("downloads") 查询 "d" = prefix；
    // Auto Edit 词首 "edit" 不应压过 prefix
    let rec = List.new()
    let k_downloads = score_entity_key("downloads", "downloads", "d", 999, rec, "downloads")
    let k_autoedit = score_entity_key("auto-edit", "auto edit", "d", 0, rec, "auto-edit")
    // downloads = prefix tier1；auto-edit 对 "d" 是 subsequence tier3（词首无 d）
    if k_downloads < k_autoedit {
        assert_eq(1, 1)
    } else {
        assert_eq(1, 0)
    }
    // 反转回归：高 si 的 prefix 优于低 si 的 subsequence
    let k_pre_hi = score_key(1, 999, 0)
    let k_sub_lo = score_key(3, 0, 5)
    if k_pre_hi < k_sub_lo {
        assert_eq(1, 1)
    } else {
        assert_eq(1, 0)
    }
}

#[test]
fn t_ac06_core_vs_handler_key_formula() {
    // core score_key 与 app.at 内联公式一致：tier*1e6+si-disc+16
    assert_eq(score_key(1, 3, 4), 1000000 + 3 - 4 + 16)
    assert_eq(score_key(2, 0, 5), 2000000 + 0 - 5 + 16)
    assert_eq(match_tier_one("calculator", "calc"), 1)
    assert_eq(match_tier_one("calc", "calc"), 0)
}

#[test]
fn t_ac01_diversity_titles() {
    if title_at(1) == "计算器" {
        assert_eq(1, 1)
    } else {
        assert_eq(1, 0)
    }
    if title_at(5) == title_at(6) {
        assert_eq(1, 1)
    } else {
        assert_eq(1, 0)
    }
}
